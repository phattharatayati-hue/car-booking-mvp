generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN  // พนักงานหลังบ้านทั่วไป
  DEV    // ผู้ดูแลระบบ เห็นหน้าตั้งค่าและจัดการแอดมิน
  DRIVER // คนรับ-ส่งรถ ใช้งานผ่านแชท LINE เท่านั้น เข้าหลังบ้านไม่ได้
}

enum CarSource {
  OWN
  PARTNER
}

enum CarStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  REQUESTED         // รถพาร์ทเนอร์ — รอแอดมินเช็คกับเจ้าของรถ
  REJECTED          // เจ้าของรถแจ้งว่าไม่ว่าง
  PENDING_DEPOSIT   // ลูกค้าจองแล้วรออัปโหลด/ตรวจสลิปมัดจำ
  CONFIRMED         // แอดมินยืนยันมัดจำแล้ว
  CANCELLED
  COMPLETED
}

enum DocumentKind {
  ID_CARD          // บัตรประชาชน หรือ Passport
  DRIVER_LICENSE   // ใบขับขี่
  TRAVEL_PROOF     // เอกสารการจองเดินทาง หรือที่พัก
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// งานที่แอดมินต้องออกไปทำ — ไปส่งรถ หรือไปรับรถคืน
enum HandoffKind {
  DELIVERY   // ไปส่งรถให้ลูกค้า
  PICKUP     // ไปรับรถคืนจากลูกค้า
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  lineUserId   String?  // LINE User ID สำหรับรับแจ้งเตือน (ขึ้นต้นด้วย U)
  // รหัสผูกบัญชี LINE แบบใช้ครั้งเดียว มีอายุ 10 นาที
  lineLinkCode      String?   @unique
  lineLinkExpiresAt DateTime?

  // เชื่อม Google Calendar ต่อคน (เฟส 2) — refresh token ต้องเข้ารหัสก่อนเก็บ
  googleEmail        String?
  googleRefreshToken String?
  googleCalendarId   String?   // id ของปฏิทิน "งานรับส่งรถ" ที่ระบบสร้างให้
  googleConnectedAt  DateTime?

  createdAt    DateTime @default(now())
  assignments  BookingAssignment[]
}

model Car {
  id            String    @id @default(cuid())
  name          String
  brand         String
  licensePlate  String    @unique
  pricePerDay   Int       // ราคาที่ลูกค้าจ่าย
  costPerDay    Int?      // ราคาทุนที่จ่ายเจ้าของรถ (เฉพาะรถพาร์ทเนอร์)
  photoUrl      String?
  source        CarSource @default(OWN)
  status        CarStatus @default(AVAILABLE)
  partner       Partner?  @relation(fields: [partnerId], references: [id])
  partnerId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  rates         CarRate[]
}

enum CarRateKind {
  PRICE // ตั้งราคาต่อวันใหม่สำหรับช่วงนั้น
  BLOCK // ปิดรับจองในช่วงนั้น
}

/**
 * ราคาตามช่วงวันของรถรายคัน และช่วงที่ปิดรับจอง
 * startDate/endDate เก็บเป็นเที่ยงคืนเวลาไทย และนับรวมวันสุดท้ายด้วย
 * ช่วง PRICE ห้ามทับกันเอง (ตรวจตอนบันทึก) ส่วน BLOCK ทับได้และชนะเสมอ
 */
model CarRate {
  id          String      @id @default(cuid())
  car         Car         @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId       String
  kind        CarRateKind @default(PRICE)
  label       String
  startDate   DateTime
  endDate     DateTime
  pricePerDay Int?
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([carId, startDate, endDate])
}

/// เจ้าของรถที่เอารถมาฝากปล่อยเช่า
model Partner {
  id        String   @id @default(cuid())
  name      String
  phone     String
  lineId    String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cars      Car[]
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  idCardNumber String?
  isBlacklisted Boolean @default(false)
  lineUserId  String?   // ผูกผ่าน LIFF / LINE Login เพื่อรับแจ้งเตือน
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  car         Car           @relation(fields: [carId], references: [id])
  carId       String
  customer    Customer      @relation(fields: [customerId], references: [id])
  customerId  String
  startDate   DateTime
  endDate     DateTime
  totalPrice  Int
  status      BookingStatus @default(PENDING_DEPOSIT)
  pickupPlace String?    // จุดรับรถที่ลูกค้าเลือก (เก็บเป็นข้อความ กันจุดถูกลบทีหลัง)
  returnPlace String?    // จุดคืนรถ
  note        String?
  adminNote   String?    // บันทึกภายใน เช่น ผลติดต่อเจ้าของรถ
  returnReminderSentAt DateTime?  // กันส่งเตือนคืนรถซ้ำ
  /// แจ้งลูกค้าว่ายืนยันสลิปแล้วแต่เอกสารยังไม่ครบ — ส่งได้ครั้งเดียว
  depositNotifiedAt    DateTime?
  /// แจ้งลูกค้าว่าพร้อมรับรถ (สลิปผ่าน + เอกสารครบ) — ส่งได้ครั้งเดียว
  readyNotifiedAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deposit     Deposit?
  documents   BookingDocument[]
  assignments BookingAssignment[]
}

/// เอกสารที่ลูกค้าอัปโหลดก่อนรับรถ — เก็บแบบ private ดูผ่าน /api/file เท่านั้น
model BookingDocument {
  id        String       @id @default(cuid())
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  kind      DocumentKind
  fileUrl   String
  status       DocumentStatus @default(PENDING)
  /// เหตุผลที่ไม่ผ่าน — แสดงให้ลูกค้าเห็นเพื่อส่งใหม่ให้ถูก
  rejectReason String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// อัปโหลดใหม่ทับของเดิมได้ แต่เก็บชนิดละหนึ่งไฟล์ต่อการจอง
  @@unique([bookingId, kind])
}

/// ตั้งค่าระบบ — มีแถวเดียว (id = "default")
model Settings {
  id                  String   @id @default("default")
  returnReminderOn    Boolean  @default(true)
  /// เตือนล่วงหน้ากี่นาที ก่อน "เวลานัดคืนรถ" ของการจองนั้น (ค่าเริ่มต้น 120 = 2 ชั่วโมง)
  returnReminderMinutesBefore Int @default(120)
  /// ค่าจองที่ลูกค้าโอนล่วงหน้าเพื่อกันวัน (บาท)
  bookingFee          Int      @default(500)
  /// เงินประกันรถที่เก็บวันรับรถและคืนให้หลังคืนรถ (บาท) — ไม่ได้เก็บผ่านเว็บ
  securityDeposit     Int      @default(3000)
  /// เงื่อนไขพื้นที่ให้บริการ — แสดงบนเว็บและใน LINE
  serviceNote         String   @default("การเช่ารถขับเองในจังหวัดเชียงใหม่เท่านั้น หากออกต่างจังหวัดจะมีค่าใช้จ่ายเพิ่มเติมครับ")
  updatedAt           DateTime @updatedAt

  /// ค่าคืนรถล่าช้าต่อชั่วโมง
  lateHourlyFee      Int      @default(200)
  /// เลทตั้งแต่กี่ชั่วโมงจะปัดเป็นค่าเช่าอีก 1 วัน
  lateRoundUpHours   Int      @default(4)
  /// ผ่อนปรนกี่นาทีก่อนเริ่มคิดค่าเลท (0 = ไม่ผ่อนปรน)
  lateGraceMinutes   Int      @default(0)
}

/// สถานะการจองผ่านแชท LINE (ชั่วคราว จบแล้วลบทิ้ง)
model LineDraft {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  step       String   // pick_car | pick_start | pick_end | confirm | ask_phone
  carId      String?
  startDate  DateTime?
  endDate    DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Deposit {
  id            String        @id @default(cuid())
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     String        @unique
  amount        Int
  slipImageUrl  String
  status        DepositStatus @default(PENDING)
  confirmedBy   String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
}

/// รหัส OTP สำหรับให้ลูกค้าดูประวัติการจอง — ส่งทาง LINE มีอายุ 5 นาที
model CustomerOtp {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// จุดรับ-ส่งรถที่ให้ลูกค้าเลือกตอนจอง — แอดมินเพิ่ม/ปิดได้เองในหลังบ้าน
model PickupPoint {
  id        String   @id @default(cuid())
  name      String
  /// ค่าบริการรับ-ส่ง (บาท) — 0 คือฟรี
  fee       Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ค่าธรรมเนียมรับ-คืนรถนอกเวลาทำการ — แอดมินเพิ่ม/แก้/ลบเองได้ในหลังบ้าน
/// เวลาเก็บเป็น "นาทีนับจากเที่ยงคืน" ตามเวลาไทย (0-1439)
/// ถ้า endMinute <= startMinute คือช่วงที่ข้ามเที่ยงคืน เช่น 22:00-05:00
model AfterHoursRate {
  id          String   @id @default(cuid())
  label       String   // ชื่อช่วงที่แสดงให้ลูกค้าเห็น เช่น "ช่วงดึก"
  startMinute Int
  endMinute   Int
  /// ค่าธรรมเนียมต่อครั้ง (บาท) — คิดแยกทั้งตอนรับและตอนคืน
  fee         Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// มอบหมายแอดมินไปส่งรถ / ไปรับรถคืน
/// หนึ่งงานมอบหมายให้หลายคนได้ (เช่น คนขับรถไปส่ง + คนขับรถตามไปรับกลับ)
/// และคนละคนกันระหว่างงานส่งกับงานรับได้
model BookingAssignment {
  id          String      @id @default(cuid())
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  kind        HandoffKind
  admin       AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String

  /// เวลานัดเจอลูกค้าจริง — event ในปฏิทินจะกันเวลาเดินทางให้เอง (ดู lib/assignments.ts)
  meetAt      DateTime
  /// จุดนัด — ตั้งต้นจากจุดรับ-ส่งที่ลูกค้าเลือก แต่แก้ได้
  place       String?
  note        String?

  /// ผลการซิงก์ Google Calendar (เฟส 2)
  googleEventId String?
  syncedAt      DateTime?
  syncError     String?

  /// กันแจ้งเตือนซ้ำ
  notifiedAt  DateTime?

  /// คนรับงานกดปุ่ม "รับทราบ" ในแชท LINE เมื่อไหร่ — ใช้ดูว่าเห็นงานแล้วจริง
  ackedAt     DateTime?

  /// กุญแจสุ่มสำหรับเปิดหน้าเอกสารลูกค้าของงานนี้ (/job/<viewToken>)
  /// ผูกกับงานชิ้นเดียว ใช้ได้เฉพาะช่วงเวลาใกล้เวลานัด และหายไปเมื่อถอนงาน
  viewToken   String?   @unique
  /// คนรับงานกดปิดงานจากแชท LINE เมื่อไหร่
  doneAt      DateTime?
  /// เลขไมล์ตอนส่งมอบ/รับคืน — คนรับงานพิมพ์เข้ามาในแชท
  odometer    Int?
  /// ระดับน้ำมันตอนส่งมอบ/รับคืน เช่น "เต็มถัง", "ครึ่งถัง"
  fuelLevel   String?
  photos      HandoffPhoto[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// คนเดิมรับงานเดิมซ้ำไม่ได้
  @@unique([bookingId, kind, adminUserId])
  @@index([adminUserId, meetAt])
}

/**
 * รูปสภาพรถที่คนรับ-ส่งรถถ่ายส่งเข้าแชท LINE
 * เก็บใน Vercel Blob แบบไม่เปิดสาธารณะ เข้าถึงผ่าน /api/file
 */
model HandoffPhoto {
  id           String            @id @default(cuid())
  assignment   BookingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  fileUrl      String
  createdAt    DateTime          @default(now())

  @@index([assignmentId])
}

/**
 * บันทึกประวัติการใช้งานหลังบ้าน — ใครทำอะไร เมื่อไหร่
 *
 * ไม่ผูก relation กับ AdminUser เพราะถ้าลบบัญชีทิ้ง ประวัติต้องยังอยู่
 * จึงเก็บชื่อและสิทธิ์ของคนทำ ณ เวลานั้นซ้ำลงมาในแถวนี้เลย
 */
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// null = ยังไม่ล็อกอิน (เช่น ล็อกอินไม่ผ่าน) หรือระบบทำเอง
  actorId   String?
  /// ชื่อคนทำ ณ เวลานั้น — ถ้าล็อกอินไม่ผ่านจะเก็บชื่อผู้ใช้ที่พิมพ์เข้ามา
  actorName String
  actorRole String?

  /// รหัสการกระทำ เช่น booking.deposit_confirm, user.role_change
  action    String
  /// ชนิดข้อมูลที่ถูกแก้ เช่น booking, car, adminUser
  entity    String?
  entityId  String?

  /// ข้อความไทยอ่านง่าย ใช้แสดงในหน้าประวัติ
  summary   String
  /// รายละเอียดเพิ่ม เช่น ค่าก่อน → หลัง
  detail    String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}
