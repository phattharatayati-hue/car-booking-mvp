generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum CarSource {
  OWN
  PARTNER
}

enum CarStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  REQUESTED         // รถพาร์ทเนอร์ — รอแอดมินเช็คกับเจ้าของรถ
  REJECTED          // เจ้าของรถแจ้งว่าไม่ว่าง
  PENDING_DEPOSIT   // ลูกค้าจองแล้วรออัปโหลด/ตรวจสลิปมัดจำ
  CONFIRMED         // แอดมินยืนยันมัดจำแล้ว
  CANCELLED
  COMPLETED
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  lineUserId   String?  // LINE User ID สำหรับรับแจ้งเตือน (ขึ้นต้นด้วย U)
  // รหัสผูกบัญชี LINE แบบใช้ครั้งเดียว มีอายุ 10 นาที
  lineLinkCode      String?   @unique
  lineLinkExpiresAt DateTime?
  createdAt    DateTime @default(now())
}

model Car {
  id            String    @id @default(cuid())
  name          String
  brand         String
  licensePlate  String    @unique
  pricePerDay   Int       // ราคาที่ลูกค้าจ่าย
  costPerDay    Int?      // ราคาทุนที่จ่ายเจ้าของรถ (เฉพาะรถพาร์ทเนอร์)
  photoUrl      String?
  source        CarSource @default(OWN)
  status        CarStatus @default(AVAILABLE)
  partner       Partner?  @relation(fields: [partnerId], references: [id])
  partnerId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

/// เจ้าของรถที่เอารถมาฝากปล่อยเช่า
model Partner {
  id        String   @id @default(cuid())
  name      String
  phone     String
  lineId    String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cars      Car[]
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  idCardNumber String?
  isBlacklisted Boolean @default(false)
  lineUserId  String?   // ผูกผ่าน LIFF / LINE Login เพื่อรับแจ้งเตือน
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  car         Car           @relation(fields: [carId], references: [id])
  carId       String
  customer    Customer      @relation(fields: [customerId], references: [id])
  customerId  String
  startDate   DateTime
  endDate     DateTime
  totalPrice  Int
  status      BookingStatus @default(PENDING_DEPOSIT)
  note        String?
  adminNote   String?    // บันทึกภายใน เช่น ผลติดต่อเจ้าของรถ
  returnReminderSentAt DateTime?  // กันส่งเตือนคืนรถซ้ำ
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deposit     Deposit?
}

/// ตั้งค่าระบบ — มีแถวเดียว (id = "default")
model Settings {
  id                  String   @id @default("default")
  returnReminderOn    Boolean  @default(true)
  returnReminderDays  Int      @default(1)   // เตือนล่วงหน้ากี่วันก่อนคืนรถ
  returnReminderHour  Int      @default(9)   // เตือนเวลากี่โมง (0-23 เวลาไทย)
  openHour            Int      @default(8)   // เวลาเปิดรับ-คืนรถ
  closeHour           Int      @default(20)  // เวลาปิด
  updatedAt           DateTime @updatedAt
}

/// สถานะการจองผ่านแชท LINE (ชั่วคราว จบแล้วลบทิ้ง)
model LineDraft {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  step       String   // pick_car | pick_start | pick_end | confirm | ask_phone
  carId      String?
  startDate  DateTime?
  endDate    DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Deposit {
  id            String        @id @default(cuid())
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     String        @unique
  amount        Int
  slipImageUrl  String
  status        DepositStatus @default(PENDING)
  confirmedBy   String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
}
